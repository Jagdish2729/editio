# EDITIO AI provider
EDITIO_AI_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Set false for a real AI test. Set true only for local fallback testing.
EDITIO_AI_FALLBACK=false

